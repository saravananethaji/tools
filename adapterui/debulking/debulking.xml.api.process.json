{
  "id": "direct:debulking.xml.api.process",
  "name": "Process template for debulking xml",
  "xmlRoute": "",
  "type": "PROCESS",
  "inputParameters": [
    {
      "name": "process.routeId",
      "helpText": "Provide the input entry route id available in the camel route",
      "isMandatory": "true"
    },
    {
      "name": "result.filename",
      "helpText": "Name of the output file",
      "isMandatory": "true"
    },
    {
      "name": "httpRequestType",
      "helpText": "Provide  HTTP Method used to invoke the configured API",
      "isMandatory": "true"
    },
    {
      "name": "https.config",
      "helpText": "Switch to enable SSL/TLS Connection",
      "isMandatory": "true"
    },
    {
      "name": "httpEndPoint",
      "helpText": "Provide HTTP Endpoint URL used to invoke the configured API ",
      "isMandatory": "true"
    },
    {
      "name": "xslt.transform.spec",
      "helpText": "Provide Data transform specification (Jolt / XSLT ) template string in BASE64 encoded format",
      "isMandatory": "true"
    },
    {
      "name": "output.folder",
      "helpText": "Provide absolute folder path for the Output folder to write output files",
      "isMandatory": "true"
    },
    {
      "name": "outputfileFields",
      "helpText": "Provide the list of fields to be provided in the output file",
      "isMandatory": "true"
    },
    {
      "name": "recordIdField",
      "helpText": "Provide the record header id field provided in csvHeaders . it should be one of the field in nestedFields.",
      "isMandatory": "true"
    },
    {
      "name": "csvHeaders",
      "helpText": "Header of CSV Record",
      "isMandatory": "true"
    }
  ],
  "defaultParameters": [
    {
      "name": "keySeparator",
      "value": "/",
      "helpText": "Key separator of csv file",
      "isMandatory": "true"
    },
    {
      "name": "valueSeparator",
      "value": "/",
      "helpText": "Value separator of csv file",
      "isMandatory": "true"
    }
  ]
}