{
  "id": "direct:debulking.xml.preprocess",
  "name": "Pre-process template for debulking xml",
  "xmlRoute": "",
  "type": "PREPROCESS",
  "inputParameters": [
    {
      "name": "data.filepath",
      "helpText": "Provide absolute folder path for the input file",
      "isMandatory": "true"
    },
    {
      "name": "data.filename",
      "helpText": "Provide input file name",
      "isMandatory": "true"
    },
    {
      "name": "process.routeId",
      "helpText": "Provide the input entry route id available in the camel route",
      "isMandatory": "true"
    },
    {
      "name": "token",
      "helpText": "Initiation point of the XML File",
      "isMandatory": "true"
    },
    {
      "name": "recordCount",
      "helpText": "Record Count",
      "isMandatory": "true"
    }
  ],
  "defaultParameters": [
    {
      "name": "keySeparator",
      "value": "/",
      "helpText": "Key separator of csv file",
      "isMandatory": "true"
    },
    {
      "name": "valueSeparator",
      "value": "/",
      "helpText": "Value separator of csv file",
      "isMandatory": "true"
    }
  ]
}