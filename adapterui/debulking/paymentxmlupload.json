{
  "type": "DEBULKING",
  "name": "PAYMENTXML",
  "status": "START",
  "templates": [
    {
      "id": "direct:debulking.xml.preprocess",
      "type": "PREPROCESS",
      "inputParameters": [
        {
          "name": "data.filepath",
          "value": "/var/lib/processed"
        },
        {
          "name": "data.filename",
          "value": "payment.xml"
        },
        {
          "name": "process.routeId",
          "value": "direct:debulking.xml.preprocess"
        },
        {
          "name": "token",
          "value": "row"
        },
        {
          "name": "expectedRecordCount",
          "value": "100"
        },
        {
          "name": "data.split.size",
          "value": "3"
        }
      ],
      "defaultParameters": []
    },
    {
      "id": "direct:debulking.xml.api.process",
      "type": "PROCESS",
      "inputParameters": [
        {
          "name": "process.routeId",
          "value": "direct:debulking.xml.api.process"
        },
        {
          "name": "result.filename",
          "value": "paymentxml_result.csv"
        },
        {
          "name": "httpRequestType",
          "value": "POST"
        },
        {
          "name": "https.config",
          "value": "false"
        },
        {
          "name": "httpEndPoint",
          "value": "http://mockip:3000/irf-provider-container/api/v1.0.0/order/paymentOrders/sepaInstantPayment"
        },
        {
          "name": "xslt.transform.spec",
          "value": ""
        },
        {
          "name": "output.folder",
          "value": "/var/lib/processed"
        },
        {
          "name": "outputfileFields",
          "value": "header,body,error"
        },
        {
