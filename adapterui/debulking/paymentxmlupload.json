          "value": "body.debitAccountIBAN"
        },
        {
          "name": "csvHeaders",
          "value": "header/id,header/transactionStatus,header/audit/T24_time,header/audit/requestParse_time,header/audit/versionNumber,header/audit/responseParse_time,header/status,body/paymentCurrencyId,body/paymentScheme,body/amount,body/orderingCustomerId,body/debitCurrency,body/debitAccountIBAN,body/orderingCustomerAddress,body/endToEndReference,body/beneficiaryIBAN,body/debitAccountId,body/orderingCustomerName,body/paymentOrderProductId,error/type,error/errorDetails[]fieldName,error/errorDetails[]code,error/errorDetails[]message,error/code,error/message"
        }
      ],
      "defaultParameters": []
    },
    {
      "id": "direct:debulking.xml.api.postprocess",
      "type": "POSTPROCESS",
      "inputParameters": [],
      "defaultParameters": []
    }
  ],
  "parameters": {
    "output.generation.stage": "preprocess"
  },
  "cronExpression": "0 */2 * ? * *"
}